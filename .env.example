# =========================================================
# ग्राम पंचायत एवं सरपंच पोर्टल - पर्यावरण चर (Environment Variables)
# =========================================================

# सर्वर पोर्ट (Server Port)
PORT=3000

# सर्वर होस्ट एवं नेटवर्क एक्सेस (Host & Network Access)
HOST=0.0.0.0
LOCAL_URL=http://localhost:3000
NETWORK_URL=http://10.151.14.28:3000

# डेटाबेस कॉन्फ़िगरेशन (SQL Database Configuration)
DB_TYPE=sqlite
DB_FILE=./data/sarpanch.sqlite

# वैकल्पिक MySQL कॉन्फ़िगरेशन (Optional MySQL Database Settings)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sarpanch_db

# पर्यावरण मोड (Environment Mode)
NODE_ENV=development

# एडमिन क्रेडेंशियल (Admin Credentials)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# सेशन सीक्रेट (Session Secret)
SESSION_SECRET=sarpanch_gram_panchayat_portal_secret_2026

# ग्राम पंचायत नाम (Default Village Name)
VILLAGE_NAME=मेरा गाँव (काकोड़ा)
