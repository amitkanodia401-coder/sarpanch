{
  "version": 2,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "views/**",
        "data/**",
        "public/**",
        "node_modules/sql.js/dist/**"
      ]
    },
    "server.js": {
      "includeFiles": [
        "views/**",
        "data/**",
        "public/**",
        "node_modules/sql.js/dist/**"
      ]
    }
  }
}
