<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <style>
    .admin-tab-section {
      display: none;
    }
    .admin-tab-section.active {
      display: block;
      animation: fadeIn 0.25s ease;
    }
    .view-toggle-btn.active {
      background: #108e5e !important;
      color: white !important;
    }
  </style>
</head>
<body class="admin-body">

  <%- include('../partials/admin-sidebar') %>

  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-title">
        <h1 id="topbarTitle">डैशबोर्ड - ग्राम पंचायत प्रबंधन</h1>
      </div>

      <div class="admin-topbar-actions">
        <a href="/" target="_blank" class="btn btn-outline btn-sm" style="font-size: 13px; font-weight: 600;">
          <i class="fa-solid fa-arrow-up-right-from-square"></i> सार्वजनिक वेबसाइट
        </a>

        <div class="admin-user-profile">
          <div class="admin-user-avatar">
            A
          </div>
          <div class="admin-user-info">
            <h4>Admin</h4>
            <span>सुपर एडमिन (प्रशासक)</span>
          </div>
        </div>
      </div>
    </header>

    <main class="admin-content">

      <!-- ====================================================
           TAB 1: डैशबोर्ड (Screen 7 - Dashboard)
           ==================================================== -->
      <section id="section-dashboard" class="admin-tab-section <%= activeTab === 'dashboard' ? 'active' : '' %>">
        <!-- Upcoming Gram Sabha Meeting Notification Admin Banner/Card -->
        <div class="admin-card" style="margin-bottom: 24px; padding: 22px 24px; border-left: 5px solid #108e5e; background: linear-gradient(to right, #f0fdf4, #ffffff); box-shadow: 0 2px 8px rgba(0,0,0,0.04);">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
            <div style="display: flex; gap: 16px; align-items: flex-start; flex: 1; min-width: 280px;">
              <div style="width: 48px; height: 48px; background: #e8f5ee; border-radius: 12px; display: flex; align-items: center; justify-content: center; color: #108e5e; font-size: 22px; flex-shrink: 0; box-shadow: 0 2px 6px rgba(16,142,94,0.15);">
                <i class="fa-solid fa-bullhorn"></i>
              </div>
              <div style="flex: 1;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 6px; flex-wrap: wrap;">
                  <h3 style="font-size: 17px; font-weight: 800; color: #0f172a; margin: 0;">
                    <%= (locals.gramSabha && gramSabha.title) ? gramSabha.title : 'आगामी ग्राम सभा खुली बैठक' %>
                  </h3>
                  <span class="status-chip <%= (locals.gramSabha && gramSabha.active) ? 'green' : 'amber' %>" style="font-size: 11px;">
                    <i class="fa-solid <%= (locals.gramSabha && gramSabha.active) ? 'fa-circle-check' : 'fa-circle-pause' %>"></i>
                    <%= (locals.gramSabha && gramSabha.status) ? gramSabha.status : 'सक्रिय प्रसारण' %>
                  </span>
                </div>
                <div style="display: flex; gap: 14px; font-size: 13.5px; color: #334155; margin-bottom: 8px; flex-wrap: wrap;">
                  <span><strong>📅 दिनांक:</strong> <%= (locals.gramSabha && gramSabha.date) ? gramSabha.date : '15 अगस्त 2024' %></span>
                  <span><strong>⏰ समय:</strong> <%= (locals.gramSabha && gramSabha.time) ? gramSabha.time : 'प्रातः 10:00 बजे' %></span>
                  <span><strong>📍 स्थान:</strong> <%= (locals.gramSabha && gramSabha.location) ? gramSabha.location : 'ग्राम पंचायत भवन चौपाल (काकोड़ा)' %></span>
                </div>
                <p style="font-size: 13px; color: #64748b; line-height: 1.5; margin: 0;">
                  <strong style="color: #1e293b;">🎯 मुख्य एजेंडा:</strong> <%= (locals.gramSabha && gramSabha.agenda) ? gramSabha.agenda : 'जल निकासी नाली, अमृत सरोवर और नई स्ट्रीट लाइट योजना।' %>
                </p>
              </div>
            </div>
            <div>
              <button type="button" onclick="openAdminModal('editGramSabhaModal')" class="btn btn-primary" style="background: #108e5e; border-radius: 8px; font-size: 13.5px; padding: 10px 18px; display: flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(16,142,94,0.25); white-space: nowrap;">
                <i class="fa-solid fa-pen-to-square"></i> बैठक विवरण संपादित करें
              </button>
            </div>
          </div>
        </div>

        <!-- Section Title -->
        <div style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
          <h2 style="font-size: 18px; font-weight: 700; color: #1e293b;">आज की गतिविधि एवं विज़िटर आंकड़े</h2>
          <span style="font-size: 13px; color: #64748b;"><i class="fa-solid fa-clock-rotate-left"></i> स्वचालित रियल-टाइम अपडेट</span>
        </div>

        <!-- 4 KPI Metrics (Screen 7) -->
        <div class="stats-cards-grid">
          <div class="kpi-card">
            <div class="kpi-title">कुल विज़िटर्स</div>
            <div class="kpi-value-row">
              <div class="kpi-value"><%= stats.totalVisitors.toLocaleString('en-IN') %></div>
              <div class="kpi-badge up">
                <i class="fa-solid fa-arrow-up"></i> +12%
              </div>
            </div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">अद्वितीय विज़िटर्स</div>
            <div class="kpi-value-row">
              <div class="kpi-value"><%= stats.uniqueVisitors.toLocaleString('en-IN') %></div>
              <div class="kpi-badge up">
                <i class="fa-solid fa-arrow-up"></i> +8%
              </div>
            </div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">देखे गए पेज</div>
            <div class="kpi-value-row">
              <div class="kpi-value"><%= stats.pageViews.toLocaleString('en-IN') %></div>
              <div class="kpi-badge up">
                <i class="fa-solid fa-arrow-up"></i> +15%
              </div>
            </div>
          </div>

          <div class="kpi-card">
            <div class="kpi-title">औसत समय</div>
            <div class="kpi-value-row">
              <div class="kpi-value"><%= stats.avgDuration %></div>
              <div class="kpi-badge up" style="background: #e0f2fe; color: #0284c7;">
                मिनट
              </div>
            </div>
          </div>
        </div>

        <!-- Live Candidate Support Status / Tracker (सरपंच पद समर्थन रिपोर्ट) -->
        <% 
          const totalSupportVotes = candidates.reduce((sum, c) => sum + (Number(c.votes) || 0), 0);
          const sortedCandidates = [...candidates].sort((a, b) => (Number(b.votes) || 0) - (Number(a.votes) || 0));
        %>
        <div class="admin-card" style="margin-bottom: 28px; border: 1px solid #fed7aa; background: #ffffff; box-shadow: 0 4px 14px rgba(234, 88, 12, 0.08); border-radius: 14px; overflow: hidden;">
          <div style="background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%); border-bottom: 1px solid #fed7aa; padding: 18px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
              <div style="display: flex; align-items: center; gap: 10px;">
                <span style="background: #ea580c; color: white; width: 34px; height: 34px; border-radius: 8px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; box-shadow: 0 2px 6px rgba(234, 88, 12, 0.3);">
                  <i class="fa-solid fa-square-poll-vertical"></i>
                </span>
                <h3 style="font-size: 19px; font-weight: 800; color: #9a3412; margin: 0;">सरपंच पद उम्मीदवार - लाइव जन समर्थन रिपोर्ट</h3>
              </div>
              <p style="font-size: 13.5px; color: #7c2d12; margin: 4px 0 0 44px;">
                ग्रामवासियों द्वारा दिया गया लाइव समर्थन • कुल दर्ज समर्थन: <strong style="color: #ea580c; font-size: 16px;"><%= totalSupportVotes %> मत</strong>
              </p>
            </div>

            <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
              <button type="button" onclick="resetSupportVotes()" class="btn btn-sm" style="background: #ef4444; color: white; border: none; font-weight: 700; padding: 8px 16px; border-radius: 8px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 2px 6px rgba(239, 68, 68, 0.25); cursor: pointer;">
                <i class="fa-solid fa-rotate-left"></i> समर्थन 0 करें (रीसेट)
              </button>
              <button type="button" onclick="switchTab('votes')" class="btn btn-sm" style="background: #ef4444; color: white; border: none; font-weight: 600; padding: 8px 14px; border-radius: 8px; margin-right: 8px;"><i class="fa-solid fa-heart"></i> समर्थन लॉग्स (IP व डिवाइस)</button>
              <button type="button" onclick="switchTab('candidates')" class="btn btn-sm btn-outline" style="border-color: #fdba74; color: #9a3412; font-weight: 600; padding: 8px 14px; border-radius: 8px; background: white;">
                उम्मीदवार विवरण देखें &rarr;
              </button>
            </div>
          </div>

          <div style="padding: 22px 24px;">
            <% if (totalSupportVotes === 0) { %>
              <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 10px; padding: 16px 20px; margin-bottom: 20px; display: flex; align-items: center; gap: 14px;">
                <i class="fa-solid fa-circle-info" style="color: #64748b; font-size: 20px;"></i>
                <div style="font-size: 13.5px; color: #475569;">
                  <strong>वर्तमान स्थिति:</strong> सभी उम्मीदवारों का समर्थन <strong>0</strong> है। जब कोई नागरिक होम पेज या उम्मीदवार प्रोफाइल पर <em>'समर्थन'</em> बटन दबाएगा, तो केवल उस उम्मीदवार का समर्थन 1 बढ़ेगा और यहाँ लाइव दिखेगा।
                </div>
              </div>
            <% } %>

            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 18px;">
              <% sortedCandidates.forEach((c, idx) => { 
                const candVotes = Number(c.votes) || 0;
                const percent = totalSupportVotes > 0 ? Math.round((candVotes / totalSupportVotes) * 100) : 0;
                const isLeader = totalSupportVotes > 0 && idx === 0 && candVotes > 0;
              %>
                <div style="border: 1px solid <%= isLeader ? '#f59e0b' : '#e2e8f0' %>; background: <%= isLeader ? '#fffbeb' : '#ffffff' %>; border-radius: 12px; padding: 16px 18px; position: relative; box-shadow: <%= isLeader ? '0 4px 12px rgba(245, 158, 11, 0.15)' : 'none' %>;">
                  <% if (isLeader) { %>
                    <span style="position: absolute; top: -10px; right: 16px; background: #f59e0b; color: white; font-size: 11px; font-weight: 700; padding: 2px 10px; border-radius: 999px; box-shadow: 0 2px 4px rgba(245, 158, 11, 0.3);">
                      🏆 सर्वाधिक समर्थन
                    </span>
                  <% } %>

                  <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
                    <img src="<%= c.photo %>" alt="<%= c.name %>" style="width: 54px; height: 54px; border-radius: 50%; object-fit: cover; border: 2px solid <%= isLeader ? '#f59e0b' : '#cbd5e1' %>;">
                    <div style="flex: 1;">
                      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                        <h4 style="font-size: 16.5px; font-weight: 700; color: #1e293b; margin: 0;"><%= c.name %></h4>
                        <span class="party-badge <%= c.partyBadge ? c.partyBadge.toLowerCase() : '' %>" style="margin: 0; font-size: 11px;"><%= c.party %></span>
                      </div>
                      <div style="font-size: 12px; color: #64748b; margin-top: 3px;">
                        <%= c.ward %> • <%= c.village %>
                      </div>
                    </div>
                    <div style="text-align: right; min-width: 70px;">
                      <div style="font-size: 24px; font-weight: 800; color: #e11d48; line-height: 1;">
                        <%= candVotes %>
                      </div>
                      <div style="font-size: 11px; color: #64748b; font-weight: 600;">समर्थन मत</div>
                    </div>
                  </div>

                  <!-- Progress Bar -->
                  <div style="margin-top: 10px;">
                    <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px; color: #475569;">
                      <span>समर्थन भागीदारी:</span>
                      <strong style="color: #1e293b;"><%= percent %>%</strong>
                    </div>
                    <div style="width: 100%; height: 8px; background: #f1f5f9; border-radius: 999px; overflow: hidden;">
                      <div style="width: <%= percent %>%; height: 100%; background: <%= isLeader ? 'linear-gradient(90deg, #f59e0b, #ea580c)' : 'linear-gradient(90deg, #f43f5e, #e11d48)' %>; border-radius: 999px; transition: width 0.4s ease;"></div>
                    </div>
                  </div>
                </div>
              <% }); %>
            </div>
          </div>
        </div>

        <!-- Charts Grid (Screen 7) -->
        <div class="charts-grid">
          <div class="chart-card">
            <div class="chart-card-header">
              <h3 class="chart-card-title">विज़िटर्स ग्राफ (साप्ताहिक)</h3>
              <span style="font-size: 12px; color: #64748b;">10-Aug — 16-Aug</span>
            </div>

            <div class="chart-container" style="height: 220px;">
              <svg viewBox="0 0 500 200" style="width: 100%; height: 100%; overflow: visible;">
                <defs>
                  <linearGradient id="areaGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                    <stop offset="0%" stop-color="#3b82f6" stop-opacity="0.35"/>
                    <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.0"/>
                  </linearGradient>
                </defs>
                <line x1="0" y1="40" x2="500" y2="40" stroke="#f1f5f9" stroke-dasharray="4"/>
                <line x1="0" y1="90" x2="500" y2="90" stroke="#f1f5f9" stroke-dasharray="4"/>
                <line x1="0" y1="140" x2="500" y2="140" stroke="#f1f5f9" stroke-dasharray="4"/>
                <polygon points="0,150 70,120 150,135 230,95 310,110 390,70 470,85 500,80 500,180 0,180" fill="url(#areaGradient)" />
                <polyline points="0,150 70,120 150,135 230,95 310,110 390,70 470,85 500,80" fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="70" cy="120" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
                <circle cx="150" cy="135" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
                <circle cx="230" cy="95" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
                <circle cx="310" cy="110" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
                <circle cx="390" cy="70" r="5" fill="#108e5e" stroke="#ffffff" stroke-width="2" />
                <circle cx="470" cy="85" r="4" fill="#2563eb" stroke="#ffffff" stroke-width="2" />
              </svg>
              <div style="display: flex; justify-content: space-between; font-size: 11px; color: #94a3b8; margin-top: 8px;">
                <span>10-Aug</span><span>11-Aug</span><span>12-Aug</span><span>13-Aug</span><span>14-Aug</span><span>15-Aug</span><span>16-Aug</span>
              </div>
            </div>
          </div>

          <div class="chart-card">
            <div class="chart-card-header">
              <h3 class="chart-card-title">पेज व्यूज</h3>
              <span style="font-size: 12px; color: #64748b;">श्रेणी अनुसार</span>
            </div>

            <div style="display: flex; justify-content: center; align-items: center; position: relative; height: 160px;">
              <svg width="150" height="150" viewBox="0 0 42 42">
                <circle class="donut-hole" cx="21" cy="21" r="15.91549430918954" fill="#fff"></circle>
                <circle class="donut-ring" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f1f5f9" stroke-width="5"></circle>
                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#108e5e" stroke-width="5" stroke-dasharray="28 72" stroke-dashoffset="25"></circle>
                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#3b82f6" stroke-width="5" stroke-dasharray="22 78" stroke-dashoffset="97"></circle>
                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#f59e0b" stroke-width="5" stroke-dasharray="18 82" stroke-dashoffset="75"></circle>
                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#8b5cf6" stroke-width="5" stroke-dasharray="12 88" stroke-dashoffset="57"></circle>
                <circle class="donut-segment" cx="21" cy="21" r="15.91549430918954" fill="transparent" stroke="#94a3b8" stroke-width="5" stroke-dasharray="20 80" stroke-dashoffset="45"></circle>
              </svg>
              <div style="position: absolute; text-align: center;">
                <strong style="font-size: 18px; color: #1e293b; display: block; line-height: 1;"><%= stats.pageViews.toLocaleString('en-IN') %></strong>
                <span style="font-size: 10px; color: #64748b;">कुल व्यूज</span>
              </div>
            </div>

            <div class="donut-legend">
              <div class="legend-item"><span><span class="legend-color-dot" style="background: #108e5e;"></span>होम</span><strong>28%</strong></div>
              <div class="legend-item"><span><span class="legend-color-dot" style="background: #3b82f6;"></span>उम्मीदवार</span><strong>22%</strong></div>
              <div class="legend-item"><span><span class="legend-color-dot" style="background: #f59e0b;"></span>विकास कार्य</span><strong>18%</strong></div>
              <div class="legend-item"><span><span class="legend-color-dot" style="background: #8b5cf6;"></span>कर्तव्य</span><strong>12%</strong></div>
              <div class="legend-item"><span><span class="legend-color-dot" style="background: #94a3b8;"></span>अन्य</span><strong>20%</strong></div>
            </div>
          </div>
        </div>

        <!-- Recent Activities (Screen 7) -->
        <div class="admin-card">
          <div class="admin-card-header">
            <h3 style="font-size: 16px; font-weight: 700; color: #1e293b;">हाल की गतिविधि</h3>
            <span style="font-size: 12.5px; color: #64748b;">वेबसाइट विज़िटर लॉग्स</span>
          </div>

          <table class="data-table">
            <thead>
              <tr>
                <th>समय</th>
                <th>उपयोगकर्ता</th>
                <th>एक्टिविटी</th>
                <th>IP एड्रेस</th>
                <th>एक्शन</th>
              </tr>
            </thead>
            <tbody>
              <% activities.forEach(act => { %>
                <tr>
                  <td><%= act.time %></td>
                  <td><strong><%= act.user %></strong></td>
                  <td><span class="status-chip blue"><%= act.action %></span></td>
                  <td style="color: #64748b; font-family: monospace;"><%= act.ip %></td>
                  <td>
                    <button onclick="switchTab('analytics')" class="icon-action-btn" title="एनालिटिक्स देखें">
                      <i class="fa-regular fa-eye"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ====================================================
           TAB 2: उम्मीदवार सूची व प्रोफाइल (Screen 2 & Screen 3)
           ==================================================== -->
      <section id="section-candidates" class="admin-tab-section <%= activeTab === 'candidates' ? 'active' : '' %>">
        <!-- Top Controls -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
          <div>
            <h2 style="font-size: 22px; font-weight: 800; color: #1e293b;">👥 उम्मीदवार सूची व प्रोफाइल (स्क्रीन 2 & 3)</h2>
            <p style="font-size: 13.5px; color: #64748b;">प्रत्याशियों का घोषणापत्र, जन समर्थन एवं विस्तृत प्रोफाइल प्रबंधन</p>
          </div>

          <div style="display: flex; gap: 10px;">
            <button onclick="openAdminModal('addCandidateModal')" class="btn btn-primary" style="background: #108e5e; border-radius: 8px;">
              <i class="fa-solid fa-user-plus"></i> नया उम्मीदवार जोड़ें
            </button>
          </div>
        </div>

        <!-- Filter Chips (Screen 2) -->
        <div class="admin-card" style="padding: 20px 24px;">
          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 20px;">
            <div class="filter-tabs" style="margin-bottom: 0;">
              <button class="filter-tab party-filter-chip active" data-party="all">सभी उम्मीदवार</button>
              <button class="filter-tab party-filter-chip" data-party="BJP">भारतीय जनता पार्टी (BJP)</button>
              <button class="filter-tab party-filter-chip" data-party="INC">कांग्रेस</button>
              <button class="filter-tab party-filter-chip" data-party="ADU">अपना दल</button>
              <button class="filter-tab party-filter-chip" data-party="IND">निर्दलीय</button>
            </div>

            <div style="display: flex; gap: 10px; align-items: center;">
              <input type="text" id="candidateSearchInput" class="admin-search-input" placeholder="उम्मीदवार का नाम खोजें..." style="width: 200px;">
              <select id="candidateWardSelect" class="form-control" style="width: 140px; padding: 8px 12px; font-size: 13px;">
                <option value="all">सभी वार्ड</option>
                <option value="वार्ड 1">वार्ड 1</option>
                <option value="वार्ड 2">वार्ड 2</option>
                <option value="वार्ड 4">वार्ड 4</option>
                <option value="वार्ड 7">वार्ड 7</option>
              </select>
            </div>
          </div>

          <!-- Candidates List (Screen 2 Layout inside Admin) -->
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <% candidates.forEach(c => { %>
              <div class="candidate-list-item" data-name="<%= c.name %>" data-party="<%= c.partyBadge %>" data-ward="<%= c.ward %>" style="border: 1px solid #e2e8f0; border-radius: 12px; padding: 18px 22px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #ffffff;">
                <div style="display: flex; align-items: center; gap: 18px;">
                  <img src="<%= c.photo %>" alt="<%= c.name %>" style="width: 64px; height: 64px; border-radius: 50%; object-fit: cover; border: 2px solid #e2e8f0;">
                  <div>
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                      <h4 style="font-size: 18px; font-weight: 700; color: #1e293b;"><%= c.name %></h4>
                      <span class="party-badge <%= c.partyBadge.toLowerCase() %>" style="margin: 0;"><%= c.party %></span>
                      <span style="font-size: 11px; background: #0f172a; color: white; padding: 2px 8px; border-radius: 999px;"><%= c.ward %></span>
                    </div>
                    <p style="font-size: 13.5px; color: #64748b; font-style: italic; margin-bottom: 4px;">"<%= c.slogan %>"</p>
                    <div style="display: flex; gap: 14px; font-size: 12px; color: #94a3b8;">
                      <span><i class="fa-solid fa-cake-candles"></i> <%= c.age %> वर्ष</span>
                      <span><i class="fa-solid fa-graduation-cap"></i> <%= c.education %></span>
                      <span><i class="fa-solid fa-location-dot"></i> <%= c.village %></span>
                      <span><i class="fa-solid fa-phone"></i> <%= c.phone %></span>
                    </div>
                  </div>
                </div>

                <div style="display: flex; align-items: center; gap: 10px;">
                  <div style="text-align: right; margin-right: 12px; background: #fff1f2; border: 1px solid #fecdd3; padding: 6px 14px; border-radius: 8px;">
                    <div style="font-size: 11px; color: #be123c; font-weight: 700;"><i class="fa-solid fa-heart"></i> कुल जन समर्थन</div>
                    <strong style="color: #e11d48; font-size: 18px;"><%= c.votes %></strong> <span style="font-size: 11px; color: #64748b;">मत</span>
                  </div>
                  <!-- View Profile Trigger (Screen 3 Modal) -->
                  <button type="button" onclick="viewCandidateProfile(<%= JSON.stringify(c) %>)" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-address-card"></i> प्रोफाइल देखें (स्क्रीन 3)
                  </button>
                  <button type="button" onclick="editCandidate(<%= JSON.stringify(c) %>)" class="icon-action-btn" title="एडिट">
                    <i class="fa-regular fa-pen-to-square"></i>
                  </button>
                  <button type="button" onclick="confirmDelete('<%= c.name %>', '/api/candidates/<%= c.id %>/delete')" class="icon-action-btn delete" title="हटाएं">
                    <i class="fa-regular fa-trash-can"></i>
                  </button>
                </div>
              </div>
            <% }); %>
          </div>
        </div>
      </section>

      
      <!-- ====================================================
           TAB 2.5: समर्थन लॉग्स (Candidate Support Logs with IP & Device)
           ==================================================== -->
      <section id="section-votes" class="admin-tab-section <%= activeTab === 'votes' ? 'active' : '' %>">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
          <div>
            <h2 style="font-size: 22px; font-weight: 800; color: #1e293b; display: flex; align-items: center; gap: 10px;">
              <span style="background: #fef2f2; color: #ef4444; width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 20px; box-shadow: 0 2px 6px rgba(239, 68, 68, 0.2);">
                <i class="fa-solid fa-heart"></i>
              </span>
              उम्मीदवार समर्थन लॉग्स (IP पता व डिवाइस विवरण)
            </h2>
            <p style="font-size: 13.5px; color: #64748b; margin-top: 4px;">
              किस विज़िटर ने किस IP पते व डिवाइस से किस उम्मीदवार को समर्थन दिया है, उसका पूर्ण रीयल-टाइम रिकॉर्ड।
            </p>
          </div>
          <div style="display: flex; gap: 10px; flex-wrap: wrap;">
            <a href="/api/export/votes.csv" class="btn btn-outline" style="background: white; border-color: #cbd5e1; font-size: 13.5px; font-weight: 600; padding: 10px 16px; border-radius: 8px; display: flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-file-csv" style="color: #108e5e;"></i> CSV डाउनलोड करें
            </a>
            <button type="button" onclick="location.reload()" class="btn btn-outline" style="background: white; border-color: #cbd5e1; font-size: 13.5px; font-weight: 600; padding: 10px 16px; border-radius: 8px; display: flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-arrows-rotate"></i> रीफ्रेश करें
            </button>
          </div>
        </div>

        <%
          const vLogs = locals.supportLogs || [];
          const uniqueIps = new Set(vLogs.map(l => l.ip)).size;
          const uniqueDevs = new Set(vLogs.map(l => l.deviceId)).size;
          const mobileCount = vLogs.filter(l => l.isMobile).length;
          const desktopCount = vLogs.length - mobileCount;
        %>

        <!-- KPI Summary Cards for Votes -->
        <div class="stats-cards-grid" style="margin-bottom: 24px;">
          <div class="kpi-card" style="border-left: 4px solid #ef4444;">
            <div class="kpi-title">कुल सत्यापित समर्थन (Votes)</div>
            <div class="kpi-value-row">
              <div class="kpi-value" style="color: #ef4444;"><%= vLogs.length %></div>
              <div class="kpi-badge up" style="background: #fef2f2; color: #dc2626;">
                <i class="fa-solid fa-shield-check"></i> 1-डिवाइस-1-वोट
              </div>
            </div>
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">प्रत्येक हार्डवेयर डिवाइस से केवल 1 बार</div>
          </div>

          <div class="kpi-card" style="border-left: 4px solid #3b82f6;">
            <div class="kpi-title">अद्वितीय IP पते (Unique IPs)</div>
            <div class="kpi-value-row">
              <div class="kpi-value" style="color: #3b82f6;"><%= uniqueIps %></div>
              <div class="kpi-badge up" style="background: #eff6ff; color: #2563eb;">
                <i class="fa-solid fa-network-wired"></i> IP नेटवर्क
              </div>
            </div>
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">अलग-अलग नेटवर्क/मोबाइल डाटा</div>
          </div>

          <div class="kpi-card" style="border-left: 4px solid #108e5e;">
            <div class="kpi-title">अद्वितीय डिवाइस (Unique Devices)</div>
            <div class="kpi-value-row">
              <div class="kpi-value" style="color: #108e5e;"><%= uniqueDevs %></div>
              <div class="kpi-badge up" style="background: #f0fdf4; color: #16a34a;">
                <i class="fa-solid fa-fingerprint"></i> फिंगरप्रिंट
              </div>
            </div>
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">हार्डवेयर व कैनवास से ट्रैक</div>
          </div>

          <div class="kpi-card" style="border-left: 4px solid #8b5cf6;">
            <div class="kpi-title">मोबाइल बनाम कंप्यूटर</div>
            <div class="kpi-value-row">
              <div class="kpi-value" style="color: #8b5cf6;"><%= mobileCount %> <span style="font-size: 14px; font-weight: normal; color: #64748b;">/ <%= desktopCount %></span></div>
              <div class="kpi-badge up" style="background: #f5f3ff; color: #7c3aed;">
                <i class="fa-solid fa-mobile-screen"></i> मोबाइल
              </div>
            </div>
            <div style="font-size: 12px; color: #64748b; margin-top: 6px;">स्मार्टफोन व पीसी से समर्थन</div>
          </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="admin-card" style="margin-bottom: 20px; padding: 18px 22px; background: #ffffff; border-radius: 12px; border: 1px solid #e2e8f0;">
          <div style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center; justify-content: space-between;">
            <div style="display: flex; gap: 12px; flex: 1; min-width: 280px; flex-wrap: wrap;">
              <div style="position: relative; flex: 1; min-width: 220px;">
                <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: #94a3b8;"></i>
                <input type="text" id="voteSearchInput" onkeyup="filterVoteLogs()" placeholder="उम्मीदवार का नाम, IP पता, डिवाइस या ब्राउज़र खोजें..." style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; outline: none;">
              </div>
              <select id="voteCandidateFilter" onchange="filterVoteLogs()" style="padding: 10px 14px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 13.5px; outline: none; background: white; color: #334155; font-weight: 500;">
                <option value="">सभी उम्मीदवार (All Candidates)</option>
                <% candidates.forEach(c => { %>
                  <option value="<%= c.name %>"><%= c.name %></option>
                <% }); %>
              </select>
            </div>
            <div style="font-size: 13px; color: #64748b; font-weight: 600;">
              दिखा रहे हैं: <span id="filteredVoteCount" style="color: #ef4444;"><%= vLogs.length %></span> / <%= vLogs.length %> रिकॉर्ड्स
            </div>
          </div>
        </div>

        <!-- Support Logs Table -->
        <div class="admin-card" style="padding: 0; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 12px;">
          <div class="table-responsive" style="max-height: 600px; overflow-y: auto;">
            <table class="admin-table" id="voteLogsTable" style="margin: 0; width: 100%; border-collapse: collapse;">
              <thead style="position: sticky; top: 0; background: #f8fafc; z-index: 2; border-bottom: 2px solid #e2e8f0;">
                <tr>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">#</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">समर्थित उम्मीदवार</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">विज़िटर IP पता (IP Address)</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">डिवाइस व ओ.एस. (Device & OS)</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">ब्राउज़र (Browser)</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">हार्डवेयर डिवाइस ID</th>
                  <th style="padding: 14px 18px; text-align: left; font-size: 13px; font-weight: 700; color: #475569;">समर्थन दिनांक व समय (IST)</th>
                  <th style="padding: 14px 18px; text-align: center; font-size: 13px; font-weight: 700; color: #475569;">सुरक्षा स्थिति</th>
                </tr>
              </thead>
              <tbody>
                <% if (vLogs.length === 0) { %>
                  <tr>
                    <td colspan="8" style="text-align: center; padding: 48px 20px; color: #94a3b8;">
                      <i class="fa-solid fa-heart-crack" style="font-size: 36px; margin-bottom: 12px; color: #cbd5e1; display: block;"></i>
                      <div style="font-size: 15px; font-weight: 600; color: #64748b;">अभी तक कोई समर्थन रिकॉर्ड नहीं मिला है</div>
                      <div style="font-size: 13px; margin-top: 4px;">जैसे ही कोई नागरिक वेबसाइट पर उम्मीदवार को समर्थन देगा, उसका IP व डिवाइस यहाँ तुरंत दिखेगा।</div>
                    </td>
                  </tr>
                <% } else { %>
                  <% vLogs.forEach((log, index) => { %>
                    <tr class="vote-log-row" data-candidate="<%= log.candidateName || '' %>" data-ip="<%= log.ip || '' %>" data-device="<%= log.device || '' %>" data-browser="<%= log.browser || '' %>">
                      <td style="padding: 14px 18px; font-size: 13px; color: #64748b; font-weight: 600;"><%= index + 1 %></td>
                      <td style="padding: 14px 18px;">
                        <div style="display: flex; align-items: center; gap: 10px;">
                          <div style="width: 38px; height: 38px; border-radius: 50%; overflow: hidden; background: #f1f5f9; flex-shrink: 0; border: 1.5px solid #fed7aa;">
                            <% if (log.candidatePhoto) { %>
                              <img src="<%= log.candidatePhoto %>" alt="<%= log.candidateName %>" style="width: 100%; height: 100%; object-fit: cover;">
                            <% } else { %>
                              <div style="width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #94a3b8; font-size: 14px;">
                                <i class="fa-solid fa-user"></i>
                              </div>
                            <% } %>
                          </div>
                          <div>
                            <div style="font-weight: 700; color: #0f172a; font-size: 14px;"><%= log.candidateName %></div>
                            <div style="font-size: 11.5px; color: #ea580c; display: flex; align-items: center; gap: 4px;">
                              <i class="fa-solid fa-check-to-slot"></i> चुनाव चिन्ह: <%= log.candidateSymbol || 'सरपंच' %>
                            </div>
                          </div>
                        </div>
                      </td>
                      <td style="padding: 14px 18px;">
                        <span style="display: inline-flex; align-items: center; gap: 6px; font-family: monospace; font-size: 13px; background: #eff6ff; color: #1d4ed8; padding: 4px 10px; border-radius: 6px; border: 1px solid #bfdbfe; font-weight: 600;">
                          <i class="fa-solid fa-network-wired" style="font-size: 11px;"></i>
                          <%= log.ip || '127.0.0.1' %>
                        </span>
                      </td>
                      <td style="padding: 14px 18px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <i class="fa-solid <%= log.isMobile ? 'fa-mobile-screen' : 'fa-laptop' %>" style="color: <%= log.isMobile ? '#108e5e' : '#3b82f6' %>; font-size: 15px;"></i>
                          <div>
                            <div style="font-weight: 600; color: #1e293b; font-size: 13px;"><%= log.device || 'Android / Desktop' %></div>
                            <div style="font-size: 11px; color: #64748b;"><%= log.os || 'Unknown OS' %></div>
                          </div>
                        </div>
                      </td>
                      <td style="padding: 14px 18px;">
                        <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; color: #334155;">
                          <i class="fa-brands fa-chrome" style="color: #f59e0b;"></i>
                          <span><%= log.browser || 'Web Browser' %></span>
                        </div>
                      </td>
                      <td style="padding: 14px 18px;">
                        <span style="font-family: monospace; font-size: 11px; background: #f8fafc; color: #475569; padding: 3px 8px; border-radius: 4px; border: 1px solid #e2e8f0;" title="<%= log.deviceId %>">
                          <%= log.deviceId ? (log.deviceId.substring(0, 14) + '...') : 'N/A' %>
                        </span>
                      </td>
                      <td style="padding: 14px 18px;">
                        <div style="font-size: 12.5px; color: #1e293b; font-weight: 500;">
                          <i class="fa-regular fa-clock" style="color: #64748b; margin-right: 4px;"></i>
                          <%= log.formattedTime || (new Date(log.timestamp)).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>
                        </div>
                      </td>
                      <td style="padding: 14px 18px; text-align: center;">
                        <span style="display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; background: #f0fdf4; color: #166534; padding: 4px 10px; border-radius: 20px; font-weight: 600; border: 1px solid #bbf7d0;">
                          <i class="fa-solid fa-circle-check"></i> 1-डिवाइस लॉक
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- ====================================================
           TAB 3: ग्राम विकास कार्य (Screen 8, 5 & 4)
           ==================================================== -->
      <section id="section-works" class="admin-tab-section <%= activeTab === 'works' ? 'active' : '' %>">
        <!-- Top Action Row -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
          <div>
            <h2 style="font-size: 22px; font-weight: 800; color: #1e293b;">🏗️ ग्राम विकास कार्य प्रबंधन (स्क्रीन 8, 5 & 4)</h2>
            <p style="font-size: 13.5px; color: #64748b;">स्वीकृत कार्य, बजट आवंटन, प्रगति बार एवं विस्तृत वित्तीय ब्यौरा</p>
          </div>

          <div style="display: flex; gap: 10px;">
            <button onclick="toggleWorksView('table')" id="btnViewTable" class="btn btn-sm view-toggle-btn active" style="border: 1px solid #cbd5e1; background: #108e5e; color: white;">
              <i class="fa-solid fa-table-list"></i> तालिका व्यू (स्क्रीन 8)
            </button>
            <button onclick="toggleWorksView('cards')" id="btnViewCards" class="btn btn-sm view-toggle-btn" style="border: 1px solid #cbd5e1; background: white; color: #334155;">
              <i class="fa-solid fa-table-cells-large"></i> गैलरी व्यू (स्क्रीन 5)
            </button>
            <button onclick="openAdminModal('addWorkModal')" class="btn btn-primary btn-sm" style="background: #108e5e;">
              <i class="fa-solid fa-plus"></i> नया कार्य जोड़ें
            </button>
          </div>
        </div>

        <!-- 1. SCREEN 8: Table Management View -->
        <div id="worksTableView" class="admin-card">
          <div class="admin-card-header">
            <div style="display: flex; gap: 8px; flex-wrap: wrap;">
              <button class="filter-tab admin-filter-tab active" data-status="all">सभी कार्य</button>
              <button class="filter-tab admin-filter-tab" data-status="पूर्ण">पूर्ण हुए कार्य</button>
              <button class="filter-tab admin-filter-tab" data-status="चालू">चालू</button>
              <button class="filter-tab admin-filter-tab" data-status="आगामी">आगामी</button>
            </div>

            <div class="admin-table-controls">
              <input type="text" id="adminTableSearch" class="admin-search-input" placeholder="कार्य का नाम खोजें...">
            </div>
          </div>

          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 50px;">क्रम</th>
                <th>कार्य का नाम</th>
                <th>स्वीकृत राशि (₹)</th>
                <th>खर्च राशि (₹)</th>
                <th>स्थिति</th>
                <th>दिनांक</th>
                <th style="text-align: right;">एक्शन</th>
              </tr>
            </thead>
            <tbody>
              <% works.forEach((w, index) => { %>
                <% 
                  let chipClass = 'green';
                  if (w.status === 'चालू') chipClass = 'amber';
                  if (w.status === 'आगामी') chipClass = 'blue';
                %>
                <tr class="work-table-row searchable-row" data-status="<%= w.status %>">
                  <td><strong><%= index + 1 %></strong></td>
                  <td>
                    <div style="display: flex; gap: 6px; align-items: center; margin-bottom: 4px; flex-wrap: wrap;">
                      <% if (w.workCode) { %>
                        <span style="font-family: monospace; font-size: 11px; font-weight: 700; color: #0284c7; background: #e0f2fe; padding: 1px 6px; border-radius: 4px;"><%= w.workCode %></span>
                      <% } %>
                      <% if (w.vouchers && w.vouchers.length) { %>
                        <span class="status-chip green" style="font-size: 10.5px; padding: 1px 6px;"><i class="fa-solid fa-receipt"></i> <%= w.vouchers.length %> वाउचर प्रमाणित</span>
                      <% } %>
                    </div>
                    <div style="font-weight: 700; color: #1e293b;"><%= w.title %></div>
                    <div style="font-size: 12px; color: #64748b;"><%= w.scheme %> • <%= w.length %></div>
                  </td>
                  <td style="font-weight: 700; color: #0f172a;">
                    ₹<%= w.budget ? w.budget.toLocaleString('en-IN') : '0' %>
                  </td>
                  <td style="color: #108e5e; font-weight: 600;">
                    ₹<%= w.spent ? w.spent.toLocaleString('en-IN') : '0' %>
                  </td>
                  <td>
                    <span class="status-chip <%= chipClass %>"><%= w.status %></span>
                  </td>
                  <td style="color: #64748b; font-size: 13px;"><%= w.endDate || w.startDate %></td>
                  <td style="text-align: right;">
                    <div class="action-btn-group" style="justify-content: flex-end;">
                      <!-- Open Screen 4 Work Detail Modal -->
                      <button type="button" onclick="viewWorkDetail(<%= JSON.stringify(w) %>)" class="btn btn-outline btn-sm" style="padding: 4px 10px; font-size: 12px;">
                        <i class="fa-solid fa-eye"></i> विवरण (स्क्रीन 4)
                      </button>
                      <button type="button" onclick="editWork(<%= JSON.stringify(w) %>)" class="icon-action-btn" title="एडिट">
                        <i class="fa-regular fa-pen-to-square"></i>
                      </button>
                      <button type="button" onclick="confirmDelete('<%= w.title %>', '/api/works/<%= w.id %>/delete')" class="icon-action-btn delete" title="हटाएं">
                        <i class="fa-regular fa-trash-can"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>

        <!-- 2. SCREEN 5: Gallery Cards View (Hidden by default, toggled with button) -->
        <div id="worksCardsView" style="display: none; margin-bottom: 28px;">
          <div class="works-grid">
            <% works.forEach(work => { %>
              <% 
                let statusClass = 'completed';
                if (work.status === 'चालू') statusClass = 'in-progress';
                if (work.status === 'आगामी') statusClass = 'upcoming';
              %>
              <div class="work-card" data-status="<%= work.status %>">
                <div class="work-card-body">
                  <div class="work-card-top-bar" style="margin-bottom: 8px;">
                    <span class="badge-work-scheme"><i class="fa-solid fa-landmark"></i> <%= work.scheme %></span>
                    <span class="work-status-badge <%= statusClass %>"><%= work.status %></span>
                  </div>
                  <h3 class="work-card-title"><%= work.title %></h3>
                  <p class="work-card-scheme"><i class="fa-solid fa-landmark"></i> <%= work.scheme %></p>
                  
                  <div style="margin-bottom: 14px;">
                    <div style="display: flex; justify-content: space-between; font-size: 12px; margin-bottom: 4px;">
                      <span style="color: #64748b;">प्रगति स्थिति</span>
                      <strong style="color: #108e5e;"><%= work.progress %>%</strong>
                    </div>
                    <div class="progress-bar-wrap" style="height: 6px; margin: 0;">
                      <div class="progress-bar-fill" style="width: <%= work.progress %>%;"></div>
                    </div>
                  </div>

                  <div class="work-card-footer">
                    <div class="work-budget-tag">
                      <span>स्वीकृत राशि</span>
                      ₹<%= work.budget.toLocaleString('en-IN') %>
                    </div>
                    <button type="button" onclick="viewWorkDetail(<%= JSON.stringify(work) %>)" class="btn btn-primary btn-sm">
                      विवरण देखें (स्क्रीन 4)
                    </button>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Reports Download Row -->
        <div class="reports-download-row">
          <div>
            <h4>रिपोर्ट डाउनलोड करें (स्क्रीन 8)</h4>
            <p style="font-size: 13px; color: #64748b;">सरकारी ऑडिट एवं ग्राम सभा हेतु प्रमाणित डेटा प्रारूप</p>
          </div>
          <div class="reports-buttons">
            <a href="/api/export/works.csv" class="btn btn-outline btn-sm">
              <i class="fa-solid fa-file-csv" style="color: #108e5e;"></i> विकास कार्य रिपोर्ट (CSV)
            </a>
            <button onclick="window.print()" class="btn btn-outline btn-sm">
              <i class="fa-solid fa-file-pdf" style="color: #ef4444;"></i> वित्तीय रिपोर्ट (PDF)
            </button>
          </div>
        </div>
      </section>

      <!-- ====================================================
           TAB 4: सरपंच के कर्तव्य (Screen 6 - Future Plan)
           ==================================================== -->
      <section id="section-duties" class="admin-tab-section <%= activeTab === 'duties' ? 'active' : '' %>">
        <div style="text-align: center; max-width: 760px; margin: 0 auto 36px;">
          <span class="party-badge bjp" style="margin-bottom: 8px;">स्क्रीन 6 (भविष्य योजना)</span>
          <h2 style="font-size: 28px; font-weight: 800; color: #1e293b;">सरपंच को क्या-क्या करना चाहिए?</h2>
          <p style="font-size: 15px; color: #64748b;">गाँव के समग्र विकास के लिए आने वाले समय में ये 5 मुख्य कार्य करने आवश्यक हैं:</p>
        </div>

        <div class="duties-list" style="margin-bottom: 40px;">
          <div class="duty-card">
            <div class="duty-num" style="background: #0ea5e9;">1</div>
            <div class="duty-content">
              <h3>बुनियादी सुविधाएं</h3>
              <p class="duty-summary" style="color: #0284c7;">• सड़क, पानी, बिजली, नाली की व्यवस्था</p>
              <p class="duty-desc">हर घर तक पक्की सड़क, 24 घंटे निर्बाध बिजली, नल से स्वच्छ पेयजल और जल निकासी की व्यवस्था करना।</p>
            </div>
          </div>

          <div class="duty-card">
            <div class="duty-num" style="background: #10b981;">2</div>
            <div class="duty-content">
              <h3>शिक्षा और स्वास्थ्य</h3>
              <p class="duty-summary" style="color: #059669;">• विद्यालयों का सुधार • स्वास्थ्य केंद्र और नियमित टीकाकरण</p>
              <p class="duty-desc">गाँव के स्कूलों में आधुनिक डिजिटल क्लासरूम, लाइब्रेरी एवं प्राथमिक स्वास्थ्य केंद्र में 24 घंटे डॉक्टर की उपलब्धता।</p>
            </div>
          </div>

          <div class="duty-card">
            <div class="duty-num" style="background: #f59e0b;">3</div>
            <div class="duty-content">
              <h3>कृषि और रोजगार</h3>
              <p class="duty-summary" style="color: #d97706;">• किसानों के लिए योजनाएं • रोजगार के नए अवसर</p>
              <p class="duty-desc">समय पर खाद-बीज उपलब्धता, पीएम किसान सम्मान निधि, सिंचाई की सुविधा और मनरेगा में पारदर्शी मजदूरी भुगतान।</p>
            </div>
          </div>

          <div class="duty-card">
            <div class="duty-num" style="background: #8b5cf6;">4</div>
            <div class="duty-content">
              <h3>सामाजिक न्याय</h3>
              <p class="duty-summary" style="color: #7c3aed;">• सभी वर्गों के लिए समान अवसर • महिला/बुजुर्ग योजनाएं</p>
              <p class="duty-desc">पेंशन योजनाओं का समय पर भुगतान, आवास योजना में निष्पक्षता, महिला स्वावलंबन और बिना भेदभाव के न्याय।</p>
            </div>
          </div>

          <div class="duty-card">
            <div class="duty-num" style="background: #06b6d4;">5</div>
            <div class="duty-content">
              <h3>डिजिटल और पारदर्शिता</h3>
              <p class="duty-summary" style="color: #0891b2;">• ऑनलाइन शिकायतें, राशन, पेंशन • सभी जानकारी पारदर्शी करना</p>
              <p class="duty-desc">पंचायत निधि के हर रुपये का खुला ऑडिट और घर बैठे सरकारी प्रमाण पत्र व शिकायत निवारण की ऑनलाइन सुविधा।</p>
            </div>
          </div>
        </div>

        <div class="duty-pledge-banner">
          <div style="font-size: 30px; margin-bottom: 10px;">🌾</div>
          <h3>ग्राम विकास का संकल्प</h3>
          <p>सरपंच का काम सिर्फ पद नहीं, जनिक सेवा है!</p>
        </div>
      </section>

      <!-- ====================================================
           TAB 5: नागरिक शिकायतें एवं सुझाव (Complaints)
           ==================================================== -->
      <section id="section-complaints" class="admin-tab-section <%= activeTab === 'complaints' ? 'active' : '' %>">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
          <div>
            <h2 style="font-size: 22px; font-weight: 800; color: #1e293b;">📩 नागरिक शिकायतें एवं सुझाव प्रबंधन</h2>
            <p style="font-size: 13.5px; color: #64748b;">ग्रामीणों द्वारा प्राप्त समस्याओं का ऑनलाइन निवारण एवं स्थिति प्रबंधन</p>
          </div>

          <button onclick="openAdminModal('newComplaintModal')" class="btn btn-primary btn-sm" style="background: #7c3aed;">
            <i class="fa-solid fa-plus"></i> नई शिकायत दर्ज करें
          </button>
        </div>

        <div class="admin-card">
          <div class="admin-card-header">
            <div style="display: flex; gap: 8px;">
              <button class="filter-tab complaint-filter-tab active" data-status="all">सभी (<%= complaints.length %>)</button>
              <button class="filter-tab complaint-filter-tab" data-status="लंबित">लंबित</button>
              <button class="filter-tab complaint-filter-tab" data-status="प्रगति पर">प्रगति पर</button>
              <button class="filter-tab complaint-filter-tab" data-status="निस्तारित">निस्तारित</button>
            </div>
          </div>

          <table class="data-table">
            <thead>
              <tr>
                <th style="width: 70px;">आईडी</th>
                <th>नागरिक</th>
                <th>वार्ड / संपर्क</th>
                <th>विषय एवं विवरण</th>
                <th>दिनांक</th>
                <th>स्थिति</th>
                <th style="text-align: right;">एक्शन</th>
              </tr>
            </thead>
            <tbody>
              <% complaints.forEach(comp => { %>
                <% 
                  let chipClass = 'amber';
                  if (comp.status === 'निस्तारित') chipClass = 'green';
                  if (comp.status === 'लंबित') chipClass = 'red';
                %>
                <tr class="complaint-row" data-status="<%= comp.status %>">
                  <td><strong>#<%= comp.id %></strong></td>
                  <td><strong><%= comp.name %></strong></td>
                  <td style="font-size: 13px;">
                    <%= comp.ward %><br>
                    <span style="color: #64748b;"><%= comp.phone %></span>
                  </td>
                  <td>
                    <div style="font-weight: 700; color: #1e293b;"><%= comp.subject %></div>
                    <div style="font-size: 12.5px; color: #64748b; max-width: 300px;"><%= comp.message %></div>
                    <% if (comp.reply) { %>
                      <div style="margin-top: 6px; font-size: 12px; background: #f0fdf4; padding: 4px 8px; border-radius: 4px; color: #166534; border: 1px solid #bbf7d0;">
                        <strong>निवारण:</strong> <%= comp.reply %>
                      </div>
                    <% } %>
                  </td>
                  <td style="font-size: 12.5px; color: #64748b;"><%= comp.date %></td>
                  <td>
                    <span class="status-chip <%= chipClass %>"><%= comp.status %></span>
                  </td>
                  <td style="text-align: right;">
                    <button type="button" onclick="openReplyModal(<%= comp.id %>, '<%= comp.status %>', '<%= (comp.reply || '').replace(/'/g, "\\'") %>')" class="btn btn-outline btn-sm">
                      <i class="fa-solid fa-reply"></i> स्थिति बदलें
                    </button>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </section>

      <!-- ====================================================
           TAB 6: विज़िटर एनालिटिक्स (Analytics)
           ==================================================== -->
      <section id="section-analytics" class="admin-tab-section <%= activeTab === 'analytics' ? 'active' : '' %>">
        <div style="margin-bottom: 24px;">
          <h2 style="font-size: 22px; font-weight: 800; color: #1e293b;">📈 विज़िटर एवं पोर्टल एनालिटिक्स</h2>
          <p style="font-size: 13.5px; color: #64748b;">वेबसाइट ट्रैफिक, पृष्ठ उपयोगिता एवं नागरिक सहभागिता का ब्यौरा</p>
        </div>

        <div class="stats-cards-grid">
          <div class="kpi-card">
            <div class="kpi-title">कुल पोर्टल विज़िटर्स</div>
            <div class="kpi-value"><%= stats.totalVisitors.toLocaleString('en-IN') %></div>
            <div style="font-size: 12px; color: #15803d; margin-top: 6px;">+12% पिछले सप्ताह से</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-title">अद्वितीय (Unique) विज़िटर्स</div>
            <div class="kpi-value"><%= stats.uniqueVisitors.toLocaleString('en-IN') %></div>
            <div style="font-size: 12px; color: #15803d; margin-top: 6px;">+8% नए ग्रामीण</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-title">कुल पेज व्यूज</div>
            <div class="kpi-value"><%= stats.pageViews.toLocaleString('en-IN') %></div>
            <div style="font-size: 12px; color: #15803d; margin-top: 6px;">+15% वृद्धि</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-title">औसत समय</div>
            <div class="kpi-value"><%= stats.avgDuration %> <span style="font-size: 14px;">मिनट</span></div>
            <div style="font-size: 12px; color: #0284c7; margin-top: 6px;">सक्रिय जुड़ाव</div>
          </div>
        </div>

        <div class="admin-card" style="padding: 24px;">
          <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 16px;">लोकप्रिय पृष्ठ एवं विज़िटर प्रतिशत</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
              <div style="font-size: 13px; color: #64748b;">होम पेज</div>
              <div style="font-size: 20px; font-weight: 800; color: #108e5e; margin: 4px 0;">28% (2,388 व्यूज)</div>
            </div>
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
              <div style="font-size: 13px; color: #64748b;">उम्मीदवार सूची व प्रोफाइल</div>
              <div style="font-size: 20px; font-weight: 800; color: #3b82f6; margin: 4px 0;">22% (1,877 व्यूज)</div>
            </div>
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
              <div style="font-size: 13px; color: #64748b;">ग्राम विकास कार्य</div>
              <div style="font-size: 20px; font-weight: 800; color: #f59e0b; margin: 4px 0;">18% (1,535 व्यूज)</div>
            </div>
            <div style="background: #f8fafc; padding: 16px; border-radius: 8px; border: 1px solid #e2e8f0;">
              <div style="font-size: 13px; color: #64748b;">सरपंच के कर्तव्य व वादे</div>
              <div style="font-size: 20px; font-weight: 800; color: #8b5cf6; margin: 4px 0;">12% (1,023 व्यूज)</div>
            </div>
          </div>
        </div>
      
        <!-- Website Visitors Log (सभी पेज विज़िटर्स - IP व डिवाइस) -->
        <% const visLogs = locals.visitorLogs || []; %>
        <div class="admin-card" style="margin-top: 24px; padding: 0; overflow: hidden; border: 1px solid #e2e8f0; border-radius: 12px;">
          <div style="padding: 18px 24px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
              <h3 style="font-size: 16px; font-weight: 700; color: #1e293b; display: flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-globe" style="color: #3b82f6;"></i>
                लाइव वेबसाइट विज़िटर ट्रैफ़िक (IP पता व डिवाइस लॉग)
              </h3>
              <p style="font-size: 12.5px; color: #64748b; margin-top: 2px;">
                गाँव की वेबसाइट पर किस-किस डिवाइस व IP पते से विज़िट हुई है उसका लाइव विवरण
              </p>
            </div>
            <span style="font-size: 12px; background: #eff6ff; color: #1d4ed8; padding: 4px 10px; border-radius: 12px; font-weight: 600; border: 1px solid #bfdbfe;">
              कुल रिकॉर्ड: <%= visLogs.length %>
            </span>
          </div>

          <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
            <table class="admin-table" style="margin: 0; width: 100%;">
              <thead style="position: sticky; top: 0; background: #f1f5f9; z-index: 2;">
                <tr>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">#</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">विज़िटर IP पता</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">डिवाइस व ओ.एस.</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">ब्राउज़र</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">देखा गया पेज</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">विज़िट संख्या</th>
                  <th style="padding: 12px 18px; font-size: 12.5px; font-weight: 700;">अंतिम विज़िट समय (IST)</th>
                </tr>
              </thead>
              <tbody>
                <% if (visLogs.length === 0) { %>
                  <tr>
                    <td colspan="7" style="text-align: center; padding: 32px 20px; color: #94a3b8;">
                      <i class="fa-solid fa-users-viewfinder" style="font-size: 28px; margin-bottom: 8px; display: block; color: #cbd5e1;"></i>
                      अभी कोई विज़िटर डेटा उपलब्ध नहीं है।
                    </td>
                  </tr>
                <% } else { %>
                  <% visLogs.slice(0, 50).forEach((v, idx) => { %>
                    <tr>
                      <td style="padding: 12px 18px; font-size: 12.5px; color: #64748b; font-weight: 600;"><%= idx + 1 %></td>
                      <td style="padding: 12px 18px;">
                        <span style="font-family: monospace; font-size: 12.5px; background: #eff6ff; color: #1e40af; padding: 3px 8px; border-radius: 4px; border: 1px solid #bfdbfe; font-weight: 600;">
                          <%= v.ip || '127.0.0.1' %>
                        </span>
                      </td>
                      <td style="padding: 12px 18px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                          <i class="fa-solid <%= v.isMobile ? 'fa-mobile-screen' : 'fa-desktop' %>" style="color: <%= v.isMobile ? '#108e5e' : '#3b82f6' %>;"></i>
                          <div>
                            <div style="font-weight: 600; font-size: 12.5px; color: #1e293b;"><%= v.device || 'Android / PC' %></div>
                            <div style="font-size: 11px; color: #64748b;"><%= v.os || 'OS' %></div>
                          </div>
                        </div>
                      </td>
                      <td style="padding: 12px 18px; font-size: 12.5px; color: #334155;">
                        <%= v.browser || 'Browser' %>
                      </td>
                      <td style="padding: 12px 18px;">
                        <span style="font-family: monospace; font-size: 12px; background: #f1f5f9; color: #334155; padding: 2px 6px; border-radius: 4px;">
                          <%= v.path || '/' %>
                        </span>
                      </td>
                      <td style="padding: 12px 18px; font-size: 12.5px; font-weight: 700; color: #108e5e;">
                        <%= v.hits || 1 %> बार
                      </td>
                      <td style="padding: 12px 18px; font-size: 12px; color: #475569;">
                        <%= v.formattedTime || (new Date(v.lastSeen)).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

      </section>

      <!-- ====================================================
           TAB 7: पंचायत सेटिंग्स (Settings)
           ==================================================== -->
      <section id="section-settings" class="admin-tab-section <%= activeTab === 'settings' ? 'active' : '' %>">
        <div style="margin-bottom: 24px;">
          <h2 style="font-size: 22px; font-weight: 800; color: #1e293b;">⚙️ ग्राम पंचायत सेटिंग्स</h2>
          <p style="font-size: 13.5px; color: #64748b;">गाँव का नाम, आबादी, संपर्क विवरण एवं पोर्टल संदेश अद्यतन करें</p>
        </div>

