  <script>
    
    function filterVoteLogs() {
      const search = (document.getElementById('voteSearchInput')?.value || '').toLowerCase().trim();
      const candFilter = (document.getElementById('voteCandidateFilter')?.value || '').toLowerCase().trim();
      const rows = document.querySelectorAll('.vote-log-row');
      let visible = 0;

      rows.forEach(row => {
        const cName = (row.getAttribute('data-candidate') || '').toLowerCase();
        const ip = (row.getAttribute('data-ip') || '').toLowerCase();
        const dev = (row.getAttribute('data-device') || '').toLowerCase();
        const browser = (row.getAttribute('data-browser') || '').toLowerCase();
        const text = row.innerText.toLowerCase();

        const matchCand = !candFilter || cName.includes(candFilter);
        const matchSearch = !search || text.includes(search) || ip.includes(search) || dev.includes(search) || browser.includes(search);

        if (matchCand && matchSearch) {
          row.style.display = '';
          visible++;
        } else {
          row.style.display = 'none';
        }
      });

      const countElem = document.getElementById('filteredVoteCount');
      if (countElem) countElem.textContent = visible;
    }
  
    // Unified SPA Tab Switcher inside single Admin URL
    function switchTab(tabName) {
      document.querySelectorAll('.admin-nav-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.admin-tab-section').forEach(s => s.classList.remove('active'));

      const activeNav = document.querySelector(`.admin-nav-tab[data-tab="${tabName}"]`);
      if (activeNav) activeNav.classList.add('active');

      const targetSection = document.getElementById(`section-${tabName}`);
      if (targetSection) targetSection.classList.add('active');

      // Update Topbar Title
      const titles = {
        'dashboard': 'डैशबोर्ड - ग्राम पंचायत प्रबंधन (स्क्रीन 7)',
        'candidates': 'सरपंच पद के उम्मीदवार सूची व प्रोफाइल (स्क्रीन 2 & 3)',
        'votes': '❤️ समर्थन लॉग्स - IP पता व डिवाइस विवरण',
        'works': 'ग्राम विकास कार्य प्रबंधन व गैलरी (स्क्रीन 8, 5 & 4)',
        'duties': 'सरपंच के कर्तव्य व भविष्य योजना (स्क्रीन 6)',
        'complaints': 'नागरिक शिकायतें एवं सुझाव प्रबंधन',
        'analytics': 'विज़िटर एनालिटिक्स व ट्रैफ़िक रिपोर्ट',
        'settings': 'ग्राम पंचायत सेटिंग्स व प्रोफाइल'
      };
      const titleElem = document.getElementById('topbarTitle');
      if (titleElem && titles[tabName]) {
        titleElem.textContent = titles[tabName];
      }

      window.history.replaceState(null, '', `/admin?tab=${tabName}`);
    }

    // Attach click events to sidebar tabs
    document.querySelectorAll('.admin-nav-tab').forEach(tab => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const tabName = tab.getAttribute('data-tab');
        switchTab(tabName);
      });
    });

    // Check URL query param or hash on initial load
    window.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const paramTab = urlParams.get('tab');
      const hashTab = window.location.hash.replace('#', '');
      const initialTab = paramTab || hashTab;
      if (initialTab && document.getElementById(`section-${initialTab}`)) {
        switchTab(initialTab);
      }
      
      // Toast for saved state
      if (urlParams.get('saved') === 'gram_sabha') {
        if (typeof showToast === 'function') {
          showToast('🏛️ आगामी ग्राम सभा बैठक सूचना सफलतापूर्वक अपडेट हो गई!');
        } else {
          alert('आगामी ग्राम सभा बैठक सूचना सफलतापूर्वक अपडेट हो गई!');
        }
      } else if (urlParams.get('saved') === '1') {
        if (typeof showToast === 'function') {
          showToast('सेटिंग्स सफलतापूर्वक सहेज ली गई हैं!');
        }
      }
    });

    // Toggle Works view between Table (Screen 8) and Cards (Screen 5)
    function toggleWorksView(viewType) {
      const tableView = document.getElementById('worksTableView');
      const cardsView = document.getElementById('worksCardsView');
      const btnTable = document.getElementById('btnViewTable');
      const btnCards = document.getElementById('btnViewCards');

      if (viewType === 'cards') {
        tableView.style.display = 'none';
        cardsView.style.display = 'block';
        btnTable.classList.remove('active');
        btnTable.style.background = 'white';
        btnTable.style.color = '#334155';
        btnCards.classList.add('active');
        btnCards.style.background = '#108e5e';
        btnCards.style.color = 'white';
      } else {
        tableView.style.display = 'block';
        cardsView.style.display = 'none';
        btnCards.classList.remove('active');
        btnCards.style.background = 'white';
        btnCards.style.color = '#334155';
        btnTable.classList.add('active');
        btnTable.style.background = '#108e5e';
        btnTable.style.color = 'white';
      }
    }

    // Active candidate profile modal (Screen 3)
    let activeCandId = null;
    function viewCandidateProfile(cand) {
      activeCandId = cand.id;
      document.getElementById('modalCandPhoto').src = cand.photo || '';
      document.getElementById('modalCandName').textContent = cand.name;
      document.getElementById('modalCandParty').textContent = cand.party;
      document.getElementById('modalCandParty').className = `party-badge ${cand.partyBadge.toLowerCase()}`;
      document.getElementById('modalCandSlogan').textContent = `"${cand.slogan}"`;
      document.getElementById('modalCandAge').textContent = `आयु: ${cand.age} वर्ष`;
      document.getElementById('modalCandEdu').textContent = `शिक्षा: ${cand.education}`;
      document.getElementById('modalCandVillage').textContent = `गाँव: ${cand.village} (${cand.ward})`;
      document.getElementById('modalCandPhone').textContent = `फोन: ${cand.phone}`;
      document.getElementById('modalCandBio').textContent = cand.bio;
      document.getElementById('modalCandVotes').textContent = cand.votes;

      // Achievements list
      const achUl = document.getElementById('modalCandAchievements');
      achUl.innerHTML = '';
      (cand.achievements || []).forEach(ach => {
        const li = document.createElement('li');
        li.innerHTML = `<span style="color: #108e5e; font-weight: bold; margin-right: 6px;">✓</span> ${ach}`;
        achUl.appendChild(li);
      });

      // Promises list
      const promDiv = document.getElementById('modalCandPromises');
      promDiv.innerHTML = '';
      (cand.promises || []).forEach((p, idx) => {
        const item = document.createElement('div');
        item.style = 'background: #f8fafc; padding: 10px 14px; border-radius: 6px; border: 1px solid #e2e8f0; font-size: 13px; display: flex; align-items: center; gap: 10px;';
        item.innerHTML = `<span style="width: 22px; height: 22px; background: #108e5e; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; flex-shrink: 0;">${idx+1}</span> <span>${p}</span>`;
        promDiv.appendChild(item);
      });

      openAdminModal('candidateProfileModal');
    }

    async function pledgeSupportModal() {
      if (!activeCandId) return;
      const res = await fetch(`/api/vote/${activeCandId}`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        document.getElementById('modalCandVotes').textContent = data.votes;
        const btn = document.getElementById('modalPledgeBtn');
        btn.innerHTML = `<i class="fa-solid fa-check"></i> समर्थन दर्ज! (${data.votes})`;
        btn.style.background = '#f97316';
        alert('समर्थन सफलतापूर्वक दर्ज हो गया!');
      }
    }

    // Active Work Detail modal (Screen 4)
    function viewWorkDetail(work) {
      document.getElementById('modalWorkHeader').textContent = `${work.title} - कार्य विवरण (स्क्रीन 4)`;
      document.getElementById('modalWorkImage').src = work.image || '';
      document.getElementById('modalWorkScheme').textContent = work.scheme;
      document.getElementById('modalWorkStart').textContent = work.startDate || '15 मार्च 2023';
      document.getElementById('modalWorkEnd').textContent = work.endDate || '10 जून 2024';
      document.getElementById('modalWorkLength').textContent = work.length || '1.2 किमी';
      document.getElementById('modalWorkContractor').textContent = work.contractor || 'शिवम कंस्ट्रक्शन';
      document.getElementById('modalWorkBudget').textContent = '₹' + (work.budget || 0).toLocaleString('en-IN');
      document.getElementById('modalWorkSpent').textContent = '₹' + (work.spent || 0).toLocaleString('en-IN');
      document.getElementById('modalWorkBalance').textContent = '₹' + (work.balance || 0).toLocaleString('en-IN');
      document.getElementById('modalWorkProgressText').textContent = `${work.progress || 0}% पूर्ण`;
      document.getElementById('modalWorkProgressBar').style.width = `${work.progress || 0}%`;
      document.getElementById('modalWorkDesc').textContent = work.description || 'गाँव की मुख्य सड़क एवं जल निकासी नाली का पक्का निर्माण।';

      openAdminModal('workDetailModal');
    }

    // Complaint status update modal
    function openReplyModal(id, status, reply) {
      const form = document.getElementById('replyComplaintForm');
      form.action = `/api/complaints/${id}/status`;
      document.getElementById('modalComplaintStatus').value = status;
      document.getElementById('modalComplaintReply').value = reply || '';
      openAdminModal('replyComplaintModal');
    }

    // Complaint filter
    document.querySelectorAll('.complaint-filter-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.complaint-filter-tab').forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        const st = tab.getAttribute('data-status');
        document.querySelectorAll('.complaint-row').forEach(row => {
          if (st === 'all' || row.getAttribute('data-status') === st) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      });
    });

    // Handle AJAX complaint submission from inside admin
    async function handleAdminComplaintSubmit(e, form) {
      e.preventDefault();
      const formData = new FormData(form);
      const res = await fetch('/api/complaint', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(formData.entries()))
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        window.location.href = '/admin?tab=complaints';
      }
    }

    // Reset Candidate Support (Votes) to 0
    async function resetSupportVotes() {
      if (!confirm('क्या आप सचमुच सभी उम्मीदवारों का जन समर्थन रीसेट करके 0 (शून्य) करना चाहते हैं?')) return;
      try {
        const res = await fetch('/api/votes/reset', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          alert('सफलता: सभी उम्मीदवारों का जन समर्थन 0 कर दिया गया है!');
          window.location.reload();
        } else {
          alert('त्रुटि: समर्थन रीसेट नहीं हो सका।');
        }
      } catch (err) {
        console.error('Reset votes error:', err);
        alert('सर्वर से संपर्क करने में समस्या हुई।');
      }
    }
  </script>

  <!-- Image Lightbox Modal for Full View in Admin -->
  <div id="imageLightboxModal" class="image-lightbox-overlay" onclick="handleLightboxBackdropClick(event)">
    <div class="image-lightbox-wrapper" onclick="event.stopPropagation()">
      <div class="image-lightbox-header">
        <div style="display: flex; align-items: center; gap: 10px; overflow: hidden;">
          <div style="width: 32px; height: 32px; background: rgba(56, 189, 248, 0.2); border-radius: 8px; display: flex; align-items: center; justify-content: center; color: #38bdf8; flex-shrink: 0;">
            <i class="fa-solid fa-image"></i>
          </div>
          <span id="imageLightboxTitle" class="image-lightbox-title">दस्तावेज / फोटो पूर्वावलोकन</span>
        </div>
        <div class="image-lightbox-actions">
          <button type="button" class="lightbox-btn" onclick="toggleLightboxZoom(event)" title="ज़ूम इन / आउट">
            <i id="lightboxZoomIcon" class="fa-solid fa-magnifying-glass-plus"></i>
          </button>
          <a id="imageLightboxDownload" href="#" target="_blank" download class="lightbox-btn" title="डाउनलोड / नया टैब">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>
          </a>
          <button type="button" class="lightbox-btn close-btn" onclick="closeImageLightbox()" title="बंद करें (Esc)">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>
      <div class="image-lightbox-body" onclick="toggleLightboxZoom(event)">
        <img id="imageLightboxImg" src="" alt="पूर्वावलोकन" style="cursor: zoom-in;" title="क्लिक करके ज़ूम करें">
      </div>
      <div id="imageLightboxMeta" class="image-lightbox-meta" style="display: none;"></div>
    </div>
  </div>

  <script src="/js/main.js"></script>
</body>
</html>
