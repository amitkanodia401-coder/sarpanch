<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
</head>
<body style="background: linear-gradient(135deg, #094d33, #0f172a); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">

  <div style="background: white; border-radius: 16px; width: 100%; max-width: 440px; box-shadow: 0 20px 40px rgba(0,0,0,0.3); overflow: hidden;">
    
    <div style="background: #108e5e; color: white; padding: 28px 24px; text-align: center;">
      <div style="width: 50px; height: 50px; background: rgba(255,255,255,0.2); border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 12px;">
        <i class="fa-solid fa-lock"></i>
      </div>
      <h2 style="font-size: 22px; font-weight: 800;">मेरा गाँव एडमिन पोर्टल</h2>
      <p style="font-size: 13px; opacity: 0.9;">ग्राम पंचायत प्रबंधन एवं नियंत्रण कक्ष</p>
    </div>

    <div style="padding: 32px 28px;">
      
      <% if (locals.error) { %>
        <div style="background: #fee2e2; color: #dc2626; border: 1px solid #fca5a5; padding: 12px 16px; border-radius: 8px; font-size: 13.5px; margin-bottom: 20px;">
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST">
        <div style="margin-bottom: 18px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">उपयोगकर्ता नाम (Username)</label>
          <div style="position: relative;">
            <i class="fa-solid fa-user" style="position: absolute; left: 14px; top: 13px; color: #94a3b8; font-size: 14px;"></i>
            <input type="text" id="loginUsername" name="username" value="admin" style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none;" required>
          </div>
        </div>

        <div style="margin-bottom: 22px;">
          <label style="display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px;">पासवर्ड (Password)</label>
          <div style="position: relative;">
            <i class="fa-solid fa-key" style="position: absolute; left: 14px; top: 13px; color: #94a3b8; font-size: 14px;"></i>
            <input type="password" id="loginPassword" name="password" value="admin123" style="width: 100%; padding: 10px 14px 10px 38px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 14px; outline: none;" required>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; border-radius: 8px; font-size: 15px;">
          <i class="fa-solid fa-right-to-bracket"></i> एडमिन लॉगिन करें
        </button>
      </form>

      <!-- Demo Credentials Helper -->
      <div style="margin-top: 24px; padding: 14px; background: #f8fafc; border-radius: 8px; border: 1px dashed #cbd5e1; font-size: 12.5px; color: #64748b; text-align: center;">
        <span style="font-weight: 700; color: #1e293b;">डेमो क्रेडेंशियल:</span><br>
        Username: <strong>admin</strong> | Password: <strong>admin123</strong>
      </div>

      <div style="text-align: center; margin-top: 20px;">
        <a href="/" style="font-size: 13.5px; color: #108e5e; font-weight: 600;">
          &larr; सार्वजनिक वेबसाइट पर वापस जाएं
        </a>
      </div>

    </div>
  </div>

</body>
</html>
