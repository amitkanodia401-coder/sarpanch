<%- include('partials/header') %>

<div class="section" style="padding-top: 36px;">
  <div class="container">

    <!-- Breadcrumb -->
    <div style="font-size: 13.5px; color: #64748b; margin-bottom: 20px;">
      <a href="/" style="color: #108e5e;"><i class="fa-solid fa-house"></i> होम</a> / <span>सरपंच के कर्तव्य व भविष्य योजना</span>
    </div>

    <!-- Header Section (Screen 6) -->
    <div style="text-align: center; max-width: 760px; margin: 0 auto 40px;">
      <span class="party-badge bjp" style="margin-bottom: 8px;">गाँव की आवाज़</span>
      <h1 style="font-size: 32px; font-weight: 800; color: #1e293b; margin-bottom: 12px;">सरपंच को क्या-क्या करना चाहिए?</h1>
      <p style="font-size: 16px; color: #64748b;">
        <%= (locals.villageInfo && villageInfo.dutiesSubtitle) ? villageInfo.dutiesSubtitle : 'गाँव के समग्र विकास और खुशहाली के लिए आने वाले समय में ये मुख्य स्तंभ मजबूत करने अनिवार्य हैं:' %>
      </p>
      <% if (locals.isAdmin) { %>
        <div style="margin-top: 14px;">
          <a href="/admin?tab=duties" class="btn btn-outline btn-sm" style="background: #fff; font-size: 13px;">
            <i class="fa-solid fa-pen-to-square"></i> एडमिन पैनल से कर्तव्य प्रबंधित करें / नया जोड़ें
          </a>
        </div>
      <% } %>
    </div>

    <!-- Dynamic Action Pillars List (Screen 6) -->
    <div class="duties-list">
      <% if (locals.duties && duties.length > 0) { %>
        <% duties.forEach((duty, idx) => { %>
          <div class="duty-card">
            <div class="duty-num" style="background: <%= duty.color || '#108e5e' %>;">
              <%= duty.num || (idx + 1) %>
            </div>
            <div class="duty-content">
              <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <% if (duty.icon) { %>
                  <i class="fa-solid <%= duty.icon %>" style="color: <%= duty.color || '#108e5e' %>; font-size: 17px;"></i>
                <% } %>
                <h3 style="margin-bottom: 0;"><%= duty.title %></h3>
              </div>
              <% if (duty.summary) { %>
                <p class="duty-summary" style="color: <%= duty.color || '#108e5e' %>;"><%= duty.summary %></p>
              <% } %>
              <p class="duty-desc">
                <%= duty.details || duty.desc || '' %>
              </p>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div style="text-align: center; padding: 40px; background: #fff; border-radius: 12px; border: 1px dashed #cbd5e1;">
          <i class="fa-solid fa-clipboard-list" style="font-size: 36px; color: #94a3b8; margin-bottom: 12px;"></i>
          <p style="font-size: 16px; color: #64748b; margin: 0;">अभी कोई कर्तव्य सूची उपलब्ध नहीं है।</p>
        </div>
      <% } %>
    </div>

    <!-- Bottom Pledge Banner (Screen 6 Banner) -->
    <div class="duty-pledge-banner">
      <div style="width: 56px; height: 56px; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; font-size: 26px;">
        <i class="fa-solid fa-handshake-angle"></i>
      </div>
      <h3>ग्राम विकास का संकल्प</h3>
      <p>सरपंच का काम सिर्फ पद नहीं, जनिक सेवा है!</p>
      <div style="margin-top: 20px;">
        <a href="/candidates" class="btn btn-secondary btn-lg">
          योग्य उम्मीदवार देखें <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </div>

  </div>
</div>

<%- include('partials/footer') %>
