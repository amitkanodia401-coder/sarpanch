          </ul>
        </div>

        <div class="footer-col">
          <h4>पंचायत कार्यालय</h4>
          <p style="font-size: 13.5px; margin-bottom: 8px;"><i class="fa-solid fa-location-dot"></i> <%= villageInfo.name %>, <%= villageInfo.district %>, <%= villageInfo.state %></p>
          <p style="font-size: 13.5px; margin-bottom: 8px;"><i class="fa-solid fa-phone"></i> <%= villageInfo.phone %></p>
          <p style="font-size: 13.5px; margin-bottom: 8px;"><i class="fa-solid fa-envelope"></i> <%= villageInfo.email %></p>
