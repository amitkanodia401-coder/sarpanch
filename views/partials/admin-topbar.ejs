<header class="admin-topbar">
  <div style="display: flex; align-items: center; gap: 12px;">
    <button type="button" class="admin-sidebar-toggle" id="adminSidebarToggle" aria-label="एडमिन मेनू खोलें">
      <i class="fa-solid fa-bars"></i>
    </button>
    <div class="admin-topbar-title">
      <h1><%= pageTitle.split('|')[0].trim() %></h1>
    </div>
  </div>

  <div class="admin-topbar-actions">
    <a href="/" target="_blank" class="btn btn-outline btn-sm" style="font-size: 12.5px;">
      <i class="fa-solid fa-arrow-up-right-from-square"></i> लाइव पोर्टल
    </a>

    <div class="admin-user-profile">
      <div class="admin-user-avatar">
        A
      </div>
      <div class="admin-user-info">
        <h4>Admin</h4>
        <span>सुपर एडमिन</span>
      </div>
    <a href="/admin/logout" class="btn btn-outline btn-sm" style="font-size: 12.5px; color: #ef4444; border-color: #fca5a5; background: #fff5f5;" title="एडमिन पैनल से बाहर निकलें">
      <i class="fa-solid fa-arrow-right-from-bracket"></i> लॉगआउट
    </a>
  </div>
</header>
